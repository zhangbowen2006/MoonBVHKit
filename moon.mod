name = "zhangbowen2006/moonbvhkit"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/zhangbowen2006/MoonBVHKit.git"

license = "MIT"

keywords = [ "bvh", "mocap", "animation", "gamedev", "moonbit" ]

preferred_target = "wasm-gc"

description = "MoonBit-native BVH motion capture parser, validator, analysis helpers, and asset pipeline toolkit."
